{
  "manifest_version": 3,
  "name": "Translator",
  "version": "1.2.2",
  "permissions": ["contextMenus", "scripting", "activeTab", "storage"],
  "host_permissions": [
    "https://api-free.deepl.com/*",
    "https://api.mymemory.translated.net/*",
    "https://text.pollinations.ai/*"
  ],
  "action": {
    "default_title": "Toggle Translator"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["inject.js"],
    "run_at": "document_end"
  }],
  "commands": {
    "translate-selection": {
      "suggested_key": { "default": "Alt+T", "mac": "Alt+T" },
      "description": "Translate selected text"
    }
  }
}
